LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
DEEPGRAM_API_KEY=
GROQ_API_KEY=

# Groq model for the agent. Leave as is unless A/B testing.
LLM_MODEL=openai/gpt-oss-20b

# Set to false to strip transcripts and spoken text from SDK logs (latency lines are unaffected).
LOG_TRANSCRIPTS=true

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000

# Call recording (LiveKit Egress -> Cloudflare R2). Egress uses the Build plan's small monthly allowance.
RECORDING_ENABLED=true
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
# R2_ACCOUNT_ID= (alternative to R2_ENDPOINT: the 32-character account ID)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=talkbalt-recordings

# Call history database (local Postgres now, Railway later). Created by scripts/setup_local_db.sh.
DATABASE_URL=

# Required in the X-Admin-Token header for /api/calls. Generate with:
#   python -c 'import secrets; print(secrets.token_urlsafe(32))'
ADMIN_TOKEN=

# Business clock and opening hours, given to the agent at the start of each call.
# BUSINESS_HOURS: comma-separated "Day[-Day] HH:MM-HH:MM" entries; unlisted days are closed.
BUSINESS_TIMEZONE=Asia/Karachi
BUSINESS_HOURS=Mon-Sat 10:00-20:00
