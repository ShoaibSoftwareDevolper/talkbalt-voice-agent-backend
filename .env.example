LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
DEEPGRAM_API_KEY=
GROQ_API_KEY=

# Groq model for the agent. Leave as is unless A/B testing.
LLM_MODEL=openai/gpt-oss-20b

# Set to false to strip transcripts and spoken text from SDK logs (latency lines are unaffected).
LOG_TRANSCRIPTS=true

# Call recording (LiveKit Egress -> Cloudflare R2). Egress uses the Build plan's small monthly allowance.
RECORDING_ENABLED=true
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
# R2_ACCOUNT_ID= (alternative to R2_ENDPOINT: the 32-character account ID)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=talkbalt-recordings

# The platform API (platform-api) and the shared service token (same value in both .env.local files).
PLATFORM_API_URL=http://127.0.0.1:8001
INTERNAL_API_TOKEN=

# The voice agent's own Postgres (call report outbox) and Redis (last good business setup).
# Written by scripts/setup_docker_db.sh and scripts/setup_docker_redis.sh (see scripts/dev.sh).
VOICE_DATABASE_URL=
REDIS_URL=
